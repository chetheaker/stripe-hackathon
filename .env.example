STRIPE_SECRET_KEY=sk_test_...
# printed by `npm run stripe:listen` (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...
ANTHROPIC_API_KEY=sk-ant-...
# optional: without it the mic is disabled but typed orders still work
DEEPGRAM_API_KEY=
# Deepgram Aura-2 voice for the kiosk talking back (same key). Default: British, warm, baritone.
TTS_MODEL=aura-2-draco-en
CART_MODEL=claude-haiku-5-5
# where the customer's phone lands after paying (Checkout success_url)
PUBLIC_URL=http://localhost:5173
